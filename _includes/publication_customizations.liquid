<style>
  .publications .author em {
    font-style: normal;
    font-weight: 700;
  }

  .publications .title a {
    color: inherit;
    text-decoration: none;
  }

  .publications .title a:hover,
  .publications .title a:focus {
    color: var(--global-theme-color);
    text-decoration: underline;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const publicationLinks = {
      {% for publication in site.data.publication_links %}
        {{ publication[0] | jsonify }}: {{ publication[1] | jsonify }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };

    Object.entries(publicationLinks).forEach(([key, href]) => {
      const title = document.querySelector(`#${CSS.escape(key)} .title`);
      if (!title || title.querySelector('a')) return;

      const link = document.createElement('a');
      link.href = href;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.innerHTML = title.innerHTML;
      link.setAttribute('aria-label', `${title.textContent.trim()} (opens paper in a new tab)`);
      title.replaceChildren(link);
    });
  });
</script>
